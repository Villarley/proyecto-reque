  },
  "devDependencies": {
    "@stellar-orbit/config-eslint": "workspace:*",
    "@stellar-orbit/config-typescript": "workspace:*",
    "@types/react": "^19.0.1",
    "eslint": "^9.16.0",
    "react": "^19.0.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
